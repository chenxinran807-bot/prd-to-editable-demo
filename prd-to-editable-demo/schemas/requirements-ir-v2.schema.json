{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-ir-v2.schema.json",
  "title": "Lossless Requirements IR v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceUnits", "sourceCoverage", "requirements", "taxonomy", "pages", "regions", "actions", "coreJourneys", "blockers"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "sourceUnits": { "type": "array", "items": { "$ref": "#/$defs/sourceUnit" } },
    "sourceCoverage": { "type": "array", "items": { "$ref": "#/$defs/sourceCoverage" } },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "taxonomy": { "type": "array", "items": { "$ref": "#/$defs/taxonomyNode" } },
    "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "coreJourneys": { "type": "array", "items": { "$ref": "#/$defs/coreJourney" } },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "idArray": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "certainty": { "enum": ["explicit", "derived", "confirmed", "assumed", "missing", "conflicting"] },
    "sourceUnit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "purpose", "certainty", "quote"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "purpose": { "enum": ["product_requirement", "acceptance_criterion", "design_constraint", "business_context", "research_evidence", "delivery_metadata"] },
        "certainty": { "$ref": "#/$defs/certainty" },
        "quote": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
      }
    },
    "sourceCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["quote", "sourceIds"],
      "properties": {
        "quote": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "sourceIds": { "$ref": "#/$defs/idArray", "minItems": 1 }
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "sourceIds", "uiEligible", "taxonomyIds", "targetIds", "certainty", "acceptanceCriteria"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "text": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "sourceIds": { "$ref": "#/$defs/idArray" }, "uiEligible": { "type": "boolean" },
        "taxonomyIds": { "$ref": "#/$defs/idArray" }, "targetIds": { "$ref": "#/$defs/idArray" },
        "certainty": { "$ref": "#/$defs/certainty" },
        "exactCopy": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "componentType": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "state": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "visibleState": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" } }
      }
    },
    "taxonomyNode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "parentId"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }, "parentId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] } }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "regionIds"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }, "regionIds": { "$ref": "#/$defs/idArray" } }
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pageId", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "pageId": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "layout": { "type": "object", "additionalProperties": false, "properties": { "mode": { "$ref": "#/$defs/nonBlank" }, "alignment": { "$ref": "#/$defs/nonBlank" } } },
        "position": { "type": "object", "additionalProperties": false, "properties": { "order": { "type": "integer", "minimum": 0 }, "anchor": { "$ref": "#/$defs/nonBlank" } } },
        "behavior": { "type": "object", "additionalProperties": false, "properties": { "scroll": { "$ref": "#/$defs/nonBlank" }, "sticky": { "type": "boolean" } } },
        "prominence": { "type": "object", "additionalProperties": false, "properties": { "level": { "$ref": "#/$defs/nonBlank" }, "rationale": { "$ref": "#/$defs/nonBlank" } } }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "trigger", "visibleFeedback", "stateChange", "fromPageId", "toPageId", "regionId", "requirementIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "trigger": { "$ref": "#/$defs/nonBlank" }, "visibleFeedback": { "$ref": "#/$defs/nonBlank" }, "stateChange": { "$ref": "#/$defs/nonBlank" },
        "fromPageId": { "$ref": "#/$defs/id" }, "toPageId": { "$ref": "#/$defs/id" },
        "regionId": { "$ref": "#/$defs/id" }, "requirementIds": { "$ref": "#/$defs/idArray" }
      }
    },
    "coreJourney": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "actionIds", "startPageId", "expectedEndPageId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "actionIds": { "$ref": "#/$defs/idArray", "minItems": 1 },
        "startPageId": { "$ref": "#/$defs/id" }, "expectedEndPageId": { "$ref": "#/$defs/id" }
      }
    },
    "nonBlank": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "blocker": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "certainty", "sourceIds", "requirementId", "theme", "priority", "impact", "recommendation", "options", "resolutions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "text": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "certainty": { "$ref": "#/$defs/certainty" }, "sourceIds": { "$ref": "#/$defs/idArray" },
        "requirementId": { "$ref": "#/$defs/id" }, "theme": { "$ref": "#/$defs/nonBlank" },
        "priority": { "enum": ["P0", "P1", "P2"] }, "impact": { "$ref": "#/$defs/nonBlank" },
        "recommendation": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": ".*\\S.*" },
        "options": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/nonBlank" } },
        "resolutions": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/resolution" } }
      }
    },
    "resolution": { "type": "object", "additionalProperties": false, "required": ["option", "patches"], "properties": { "option": { "$ref": "#/$defs/nonBlank" }, "patches": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decisionPatch" } } } },
    "decisionPatch": { "type": "object", "additionalProperties": false, "required": ["entity", "id", "field", "value"], "properties": { "entity": { "enum": ["requirement", "action", "page", "region"] }, "id": { "$ref": "#/$defs/id" }, "field": { "$ref": "#/$defs/nonBlank" }, "value": {} } }
  }
}
