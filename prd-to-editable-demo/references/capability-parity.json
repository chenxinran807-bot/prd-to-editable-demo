{
  "schemaVersion": 1,
  "principle": "The unified entry may add traceability and editing, but must not replace or weaken a selected specialist result.",
  "specialists": {
    "prd-generator": {
      "useWhen": ["complex journey", "multiple roles", "product strategy sections", "many branches or states"],
      "mustPreserve": ["complete user story", "entry-to-outcome paths", "branch and state decisions", "facts separated from assumptions"],
      "deliveryPolicy": "preserve-specialist-result"
    },
    "pm-kakaxi": {
      "useWhen": ["screenshots", "design drafts", "Figma", "high-fidelity review"],
      "mustPreserve": ["visual evidence priority", "generation gating", "structured demo context", "facts, inferences and gaps"],
      "deliveryPolicy": "preserve-specialist-result"
    },
    "vne": {
      "useWhen": ["React or engineering handoff", "internal component library", "real page URL", "codebase reuse"],
      "mustPreserve": ["buildable project", "selected design system", "prototype manifest and edit anchors", "build and handoff evidence"],
      "deliveryPolicy": "preserve-specialist-result"
    },
    "inspire": {
      "useWhen": ["Inspire canvas", "inbox asset", "cloud prototype iteration"],
      "mustPreserve": ["official CLI generation", "asset identity and status", "preview and capture links", "official exported bundle or remote edit link"],
      "deliveryPolicy": "preserve-specialist-result"
    },
    "figma-flow": {
      "useWhen": ["ordered static flow screens", "sliced assets", "pixel or motion fidelity"],
      "mustPreserve": ["confirmed flow order", "confirmed asset mapping", "coordinate provenance", "asset aspect ratios and interaction timing"],
      "deliveryPolicy": "preserve-specialist-result"
    },
    "open-design": {
      "useWhen": ["Open Design", "Huashu Design", "brand-level visual exploration", "design workspace iteration"],
      "mustPreserve": ["design workspace source bundle", "visual system and tokens", "interactive preview", "specialist iteration history"],
      "deliveryPolicy": "preserve-specialist-result"
    }
  }
}
