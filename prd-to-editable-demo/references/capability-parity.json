{
  "schemaVersion": 2,
  "principle": "One installed Skill directly generates the professional core; Inspire is an optional deep-edit and hosting adapter.",
  "capabilities": {
    "semantic-understanding": {
      "useWhen": ["every PRD or product requirement"],
      "mustPreserve": ["evidence-grounded objects and actions", "task and state relationships", "facts separated from assumptions and gaps"],
      "deliveryPolicy": "standalone-core"
    },
    "interaction-design": {
      "useWhen": ["every interactive demo"],
      "mustPreserve": ["task-derived screens", "complete forward and return paths", "applicable state matrix", "trigger, system behavior and feedback"],
      "deliveryPolicy": "standalone-core"
    },
    "visual-quality": {
      "useWhen": ["every visual prototype"],
      "mustPreserve": ["platform-native hierarchy", "licensed assets and icon provenance", "zero Emoji and fake glyph icons", "subjective visual review"],
      "deliveryPolicy": "standalone-core"
    },
    "editable-runtime": {
      "useWhen": ["every delivered demo"],
      "mustPreserve": ["stable editable keys", "text, color, image, icon, position and size editing", "state and navigation editing", "undo and accepted-version lineage"],
      "deliveryPolicy": "standalone-core"
    },
    "inspire": {
      "useWhen": ["the user explicitly requests Inspire editing, hosting, inbox, or team canvas collaboration"],
      "mustPreserve": ["official CLI generation", "exact opened and activated business design Skill", "asset identity and accepted parent", "preview and inbox links"],
      "deliveryPolicy": "optional-adapter"
    }
  }
}
